# Octopus Energy API Configuration
# Get your API key and Account number from: https://octopus.energy/dashboard/developer/

# Your Octopus API Key (starts with sk_live_...)
OCTOPUS_API_KEY=

# Your Account Number (e.g. A-12345678 or 6B3B04CB)
OCTOPUS_ACCOUNT_NUMBER=

# Optional: If you provide API Key and Account Number, the scripts will automatically
# discover your MPAN, Meter Serial Number, and DNO Region Code from the API.
# Alternatively, you can specify them explicitly here:
OCTOPUS_ELECTRICITY_MPAN=
OCTOPUS_ELECTRICITY_SERIAL=
OCTOPUS_REGION=C
